# Root .env.example — copy to .env and fill in. Per-service .env.example files (once services
# have real code) override these for local runs; this is the cross-cutting reference.

# Redis (Streams + Pub/Sub)
REDIS_URL=redis://localhost:6379

# TimescaleDB + pgvector
TIMESCALEDB_URL=postgresql+asyncpg://postgres:selfheal@localhost:5432/selfheal

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# HST model hyperparameters (docs/Doc1_Technical_Architecture.md §4)
HST_N_TREES=25
HST_HEIGHT=15
HST_WINDOW_SIZE=250
ADWIN_DELTA=0.002

# LLM Copilot -- never commit a real key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend 
VITE_API_BASE=http://localhost:8000
