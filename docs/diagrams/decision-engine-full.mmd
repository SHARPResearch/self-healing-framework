%% ─────────────────────────────────────────────────────────────
classDef c1 fill:#eef2ff,stroke:#6366f1,color:#312e81,stroke-width:1px;
classDef ingest fill:#eff6ff,stroke:#60a5fa,color:#1e3a8a,stroke-width:1px;
classDef graph fill:#f0fdf4,stroke:#22c55e,color:#14532d,stroke-width:1px;
classDef proc fill:#f8fafc,stroke:#94a3b8,color:#334155,stroke-width:1px;
classDef valid fill:#fff7ed,stroke:#fb923c,color:#9a3412,stroke-width:1px;
classDef auto fill:#dcfce7,stroke:#22c55e,color:#14532d,stroke-width:2px;
classDef shadow fill:#fef9c3,stroke:#eab308,color:#713f12,stroke-width:1px;
classDef blocked fill:#fee2e2,stroke:#ef4444,color:#991b1b,stroke-width:1px;
classDef human fill:#ffedd5,stroke:#ea580c,color:#7c2d12,stroke-width:1px;
classDef exec fill:#ecfeff,stroke:#06b6d4,color:#164e63,stroke-width:1px;
classDef data fill:#f1f5f9,stroke:#64748b,color:#1e293b,stroke-width:1px;
classDef obs fill:#f5f3ff,stroke:#a78bfa,color:#4c1d95,stroke-width:1px;

class C1DET,C1MODEL,C1TOPO,C1API,C1LIVE c1;
class POLL,HEALTH,DEDUPE,ANOM,SNAP,MAILA,CLOSE ingest;
class TOPOLOAD,GSTORE,CENT,BLAST graph;
class PICK,TELE,CTX,CLASS,RC,RULES,SEV,ACT,BANAL proc;
class CONF,RISK,CONFLICT,MATRIX,GD,GC,GI,GOK valid;
class AUTO auto;
class SHADOW,SIM,OBS,VERD,VHELP,VUNNEC,VSTILL shadow;
class BLOCK blocked;
class HUMAN,EQUEUE,A1,W1,A2,W2,A3,MANUAL,ACK,APPR,REJ human;
