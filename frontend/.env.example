# Dashboard settings. Copy to frontend/.env and change what you need (it is ignored by git).
# Vite reads VITE_* values when pnpm dev or pnpm build starts.

# Decision engine and copilot (their services, on their own ports)
VITE_API_BASE=http://localhost:8000
VITE_COPILOT_API_BASE=http://localhost:8004

# Accounts: "on" shows the real sign in pages and sends a login token to ml-backend
# (run services/auth, and ml-backend with AUTH_MODE=jwt). Leave empty for the no-login demo.
VITE_AUTH=

# Only if ml-backend is on another host. Empty: the dev server forwards /api and /ws to it
# (ML_BACKEND_URL in the terminal, default http://localhost:8002).
VITE_ML_BACKEND_URL=
