{
  "name": "sharp-auth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SHARP web server: Better Auth (users, organizations, roles, invitations, JWTs), the dashboard's static files, and a proxy to ml-backend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=.env node_modules/@better-auth/cli/dist/index.mjs migrate --config src/auth.js -y",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-auth": "1.7.18",
    "express": "5.3.0",
    "http-proxy-middleware": "3.0.10",
    "pg": "8.23.1"
  }
}
