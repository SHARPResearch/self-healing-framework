# self-healing-framework\services\decision-engine\.env.example
# ─────────────────────────────────────────────────────────────
# Decision Engine — environment template
# Copy to .env and fill in real values:
#   cp .env.example .env
# .env is git-ignored; this file is safe to commit.
# ─────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════
# REQUIRED — the app refuses to start without these
# ═════════════════════════════════════════════════════════════

# Neon Postgres: anomaly events + decision log + rules + escalations
ANOMALY_DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Tiger Cloud TimescaleDB: telemetry snapshots
TELEMETRY_DB_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Neo4j Aura: dependency graph mirror
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USER=YOUR_INSTANCE_ID
NEO4J_PASSWORD=YOUR_PASSWORD
NEO4J_DATABASE=YOUR_INSTANCE_ID


# ═════════════════════════════════════════════════════════════
# OPTIONAL — Redis (guardrails cache)
# ═════════════════════════════════════════════════════════════
# If empty, guardrails fall back to in-memory (fine for dev).
# Local:  redis://localhost:6379/0
# Cloud:  rediss://default:PASSWORD@HOST:PORT
REDIS_URL=


# ═════════════════════════════════════════════════════════════
# INGESTION TUNING
# ═════════════════════════════════════════════════════════════
# RING_BUFFER_RETENTION_SEC must exceed SNAPSHOT_BEFORE + SNAPSHOT_AFTER
TELEMETRY_POLL_INTERVAL_SEC=10
ANOMALY_POLL_INTERVAL_SEC=5
RING_BUFFER_RETENTION_SEC=800
SNAPSHOT_BEFORE_SEC=300
SNAPSHOT_AFTER_SEC=300


# ═════════════════════════════════════════════════════════════
# DECISION PIPELINE
# ═════════════════════════════════════════════════════════════
DECISION_POLL_INTERVAL_SEC=10
DECISION_WINDOW_SEC=300
INCIDENT_RECOVERY_HOLD_SEC=30


# ═════════════════════════════════════════════════════════════
# ESCALATION WORKER (Phase 4 — human-in-the-loop)
# ═════════════════════════════════════════════════════════════
# How often the worker scans for due escalation attempts.
# Attempts fire at T+0, T+5min, T+15min automatically.
ESCALATION_POLL_INTERVAL_SEC=30


# ═════════════════════════════════════════════════════════════
# SHADOW MODE OBSERVER (Phase A — counterfactual analysis)
# ═════════════════════════════════════════════════════════════
SHADOW_OBSERVE_INTERVAL_SEC=60
SHADOW_MIN_AGE_SEC=300
SHADOW_MAX_WAIT_MIN=60


# ═════════════════════════════════════════════════════════════
# KUBERNETES EXECUTOR (Phase B)
# ═════════════════════════════════════════════════════════════
# DRY_RUN=1  → log calls only, no cluster needed (SAFE DEFAULT)
# DRY_RUN=0  → execute against the cluster (needs kubeconfig or in-cluster)
KUBERNETES_DRY_RUN=1
KUBERNETES_NAMESPACE=default
# IN_CLUSTER=1 → load ServiceAccount token (running inside a Pod)
# IN_CLUSTER=0 → load ~/.kube/config (dev machine)
KUBERNETES_IN_CLUSTER=0
KUBERNETES_REQUEST_TIMEOUT_SEC=20
KUBERNETES_DEFAULT_GRACE_SEC=30


# ═════════════════════════════════════════════════════════════
# INTERNAL TELEMETRY SOURCE
# ═════════════════════════════════════════════════════════════
TELEMETRY_SOURCE_URL=http://localhost:8000


# ═════════════════════════════════════════════════════════════
# DEVELOPER CONVENIENCE
# ═════════════════════════════════════════════════════════════
OPEN_DOCS=1
DOCS_BASE_URL=http://localhost:8000


# ═════════════════════════════════════════════════════════════
# EMAIL NOTIFICATIONS (SMTP / Gmail App Password)
# ═════════════════════════════════════════════════════════════
# Leave SMTP_PASSWORD empty to force DRY-RUN (log only).
# Gmail: enable 2FA → generate App Password → paste below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
NOTIFY_ENABLED=1
NOTIFY_RECIPIENT=you@example.com
NOTIFY_ON_ANOMALY=1
NOTIFY_ON_DECISION=1