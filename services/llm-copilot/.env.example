# LLM Configuration 
LLM_PROVIDER=ollama                 # ollama | gemini | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# Component 2 (Decision Engine) Integration 
COMPONENT2_BASE_URL=http://localhost:8002
COMPONENT2_WEBHOOK_SECRET=change_this_secret

# Database Configuration
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/copilot_db
VECTOR_DB_PATH=./data/chroma_db

# Security Configuration
MASKING_ENABLED=true
PII_DETECTOR_CONFIDENCE_THRESHOLD=0.85

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8004
DEBUG=true