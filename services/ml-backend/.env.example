# ml-backend settings. Copy this file to .env in the same folder and change what you need.
# Every line is optional: with no .env at all, the defaults below run the laptop demo.
# .env is ignored by git, so passwords put there are never committed.

# --- Where data goes -----------------------------------------------------------------------------
# The demo database and Redis from infrastructure/local/docker-compose.demo.yml. If they are not
# running, ml-backend still starts and keeps everything in memory instead.
DATABASE_URL=postgresql://postgres:selfheal@localhost:5433/selfheal
REDIS_URL=redis://localhost:6380

# --- What it monitors ----------------------------------------------------------------------------
# replay: replays real server telemetry (SMD) for six demo services. No Kubernetes needed.
# prometheus: monitors the live Online Boutique on minikube (run infrastructure/online-boutique/up.ps1 first).
TELEMETRY_MODE=replay
PROMETHEUS_URL=http://localhost:9090
K8S_NAMESPACE=online-boutique
GRAFANA_URL=http://localhost:3000

# --- Accounts ------------------------------------------------------------------------------------
# off: no login, everyone is the owner of one organization (the laptop demo).
# jwt: every request must carry a login token from the auth service (services/auth).
AUTH_MODE=off
AUTH_JWKS_URL=http://localhost:8010/api/auth/jwks
AUTH_ISSUER=http://localhost:5173
# How many organizations may each get their own demo fleet (each one uses memory).
MAX_TENANTS=3

# --- Demo speed ----------------------------------------------------------------------------------
# Events per second per service in replay mode. 60 makes one "day" of data pass in about 24 s.
REPLAY_EVENTS_PER_SEC=60

# --- Logs page -----------------------------------------------------------------------------------
# Show the database and Redis container logs on the Logs page (needs Docker on the PATH).
FOLLOW_CONTAINER_LOGS=true
