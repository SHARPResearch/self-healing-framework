# Context for services/ml-backend/Dockerfile (built from the repository root). Only what the image
# copies is let through; everything else (venvs, node_modules, datasets, outputs) stays out.
**
!services/ml-backend/pyproject.toml
!services/ml-backend/uv.lock
!services/ml-backend/app/**
!services/ml-backend/scripts/**
!ml-pipeline/src/**
!datasets/smd/preprocess.py
!infrastructure/local/init.sql
**/__pycache__
