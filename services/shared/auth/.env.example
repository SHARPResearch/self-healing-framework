# Shared auth service — copy to services/shared/auth/.env
# Use the SAME Neon DB as decision-engine
AUTH_DB_URL=postgresql://neondb_owner:<password>@ep-long-cake-b37gjn8k-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=<paste openssl rand -hex 32 output here>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=60
